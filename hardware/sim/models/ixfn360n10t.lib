* ============================================================================
*  IXFN360N10T  -  IXYS/Littelfuse GigaMOS Trench HiperFET  (SOT-227B)
*  100 V / 360 A N-channel power MOSFET  --  LINEAR-MODE model, rev B
* ----------------------------------------------------------------------------
*  Anchored to the ACTUAL datasheet: IXYS DS100088 (12/08), local copy at
*  hardware/datasheets/ixfn360n10t.pdf   (cross-referenced 2026-07-01)
*
*  Datasheet values used (Tj=25C):
*     VDSS     = 100 V         ID25 = 360 A       IDM = 900 A
*     VGSS     = +/-20 V continuous
*     RDS(on) <= 2.6 mOhm  (VGS=10V, Id=180A)
*     VGS(th)  = 2.5 .. 4.5 V  (VDS=VGS, Id=250uA)
*     gfs      = 160 S typ, 100 S min  (VDS=10V, Id=60A, pulse)   [p2]
*     Ciss     = 36 nF   Coss = 3.13 nF   Crss = 330 pF  (VDS=25V, 1MHz) [p2]
*     Qg(on)   = 505 nC  Qgs = 145 nC  Qgd = 135 nC (VGS=10V,VDS=50V) [p2]
*     Gate-charge plateau (Fig 9): VGS ~= 5.1 V at Id=180A, VDS=50V
*     Pd       = 830 W (Tc=25C)   RthJC = 0.18 C/W   Tj = 175 C
*     NOTE: preliminary datasheet contains NO SOA curve and no linear-mode
*     derating data -> keep per-FET dissipation conservative (<=300 W).
*
*  PHYSICS MAPPING (square law Id=(Kp/2)(Vgs-Vto)^2, anchored at 60 A):
*     Kp  = gfs^2/(2*Id) = 160^2/(2*60) = 213 A/V^2
*     Vto = Vgs(180A) - sqrt(2*180/Kp) = 5.1 - 1.30 = 3.80 V
*       -> gm(40A)=131 S, gm(60A)=160 S (datasheet anchor), gm(10A)=65 S
*       -> matches Fig 7 within ~10% below 100 A; overshoots above ~120 A
*          (real device goes sublinear) -- fine: per-FET Id <= 60 A here.
*     Vth tolerance: sweep Vto 2.5..4.5 for mismatch/corner studies.
*  Capacitances (VDMOS cap model):
*     Cgs    = Ciss - Crss = 35.7 nF (constant)
*     Cgdmax = 1.0 nF (Fig 10 Crss at VDS->0), Cgdmin = 0.30 nF (VDS=40V)
*     a tuned so Cgd(25V) ~= 330 pF
*     Cjo    = Coss - Crss = 2.8 nF
*  Rg(int): NOT specified in DS100088; 1.0 ohm estimate from resistive
*     switching times measured with RG(ext)=1 ohm. Treat as +/-100%.
* ============================================================================

.model IXFN360N10T VDMOS(
+ Vto=3.8            ; from gate-charge plateau + gfs anchor (spec 2.5-4.5)
+ Kp=213             ; gfs=160S @ 60A  [DS100088 p2]
+ Lambda=0.002       ; finite output conductance (est; Fig 1 sat slope)
+ Rd=2.2m            ; with Rs gives Rds(on)~2.6m @ Vgs=10V
+ Rs=0.3m
+ Rg=1.0             ; ESTIMATE - not in datasheet
+ Rds=1meg
+ Cgs=35.7n          ; Ciss-Crss @25V  [p2]
+ Cgdmax=1.0n        ; Crss @ VDS->0 (Fig 10)
+ Cgdmin=0.30n       ; Crss @ VDS=40V (Fig 10)
+ a=0.6              ; Cgd(25V) ~= 330p
+ Cjo=2.8n           ; Coss-Crss @25V
+ m=0.5 Vj=0.8
+ Rb=1.0m Is=2e-8 N=1.3  ; body diode: VSD=1.2V max @100A [p2]
+ mfg=IXYS Vds=100 Ron=2.6m Qg=505n )

* Convenience subcircuit wrapper (D G S)
.subckt IXFN d g s
M1 d g s s IXFN360N10T
.ends IXFN
